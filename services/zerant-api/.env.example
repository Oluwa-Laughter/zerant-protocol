DATABASE_URL=
ZERANT_PUBLIC_ORIGIN=https://zerant.vercel.app
ZERANT_VAULT_KEK_B64=
ZERANT_VAULT_KEYS_B64=
ZERANT_VAULT_KEY_VERSION=1
ZERANT_DATABASE_TLS=require
ZERANT_BIND_ADDR=0.0.0.0
ZERANT_ZCASH_CHAIN=zcash:testnet
ZERANT_ZECAUTH_SCOPES=auth,request_payment
Z3_REGTEST_RPC_ROUTER_USER=zebra
Z3_REGTEST_RPC_ROUTER_PASSWORD=
PORT=8080

# Optional production Zcash light-client services (primary first, then trusted backups).
# Remote endpoints must use HTTPS. Up to four unique endpoints are accepted.
ZERANT_LIGHT_CLIENT_ENDPOINTS=
ZERANT_LIGHT_CLIENT_ALLOW_LOOPBACK=false
# Legacy single-endpoint variable; do not set together with ZERANT_LIGHT_CLIENT_ENDPOINTS.
# ZERANT_LIGHT_CLIENT_ENDPOINT=

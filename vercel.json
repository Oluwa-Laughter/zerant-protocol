{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "ZERANT_API_ORIGIN"
        }
      ],
      "functions": {
        "src/app/api/zerant/queues/webhook-dispatch/route.ts": {
          "maxDuration": 60,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "zerant-webhook-dispatch",
              "retryAfterSeconds": 60,
              "initialDelaySeconds": 0,
              "maxConcurrency": 8
            }
          ]
        }
      }
    },
    "backend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/zerant/maintenance/retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/zerant/maintenance/health",
      "schedule": "23 * * * *"
    }
  ]
}
